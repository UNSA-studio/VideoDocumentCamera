<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>

    <!-- ══════════════ WinUI 3（Windows App SDK）══════════════ -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>

    <!--
      EnableMsixTooling=true（WinUI 3 模板的默认值）：
      它会导入 MSIX / PRI 相关的 targets，让 resources.pri 能正常生成、
      ms-appx:/// 资源引用能被解析。
      注意它不是"要求 MSIX 打包"—— 配合下面的 WindowsPackageType=None
      依然是普通的 unpackaged exe。
    -->
    <EnableMsixTooling>true</EnableMsixTooling>

    <!--
      非打包（unpackaged）模式：
      以普通 exe 运行，由 Windows App SDK 的 Bootstrap 自动初始化运行时，
      因此 MSI / EXE 安装包都不必处理 MSIX framework package，部署最干净。

      注：不设置 EnableMsixTooling —— unpackaged 项目不需要 MSIX 工具链，
          但 PRI 资源索引（resources.pri）由 Windows App SDK 的 targets 生成，
          保持默认即可，显式关掉反而可能缺少资源索引。
    -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>

    <RootNamespace>VideoPresenter.App</RootNamespace>
    <AssemblyName>VideoPresenter</AssemblyName>
    <ApplicationIcon>Assets\VideoPresenter.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- ══════════ 启动性能（i3-6 代"1 秒内可见"）══════════ -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredCompilation>true</TieredCompilation>
    <TieredCompilationQuickJit>true</TieredCompilationQuickJit>
    <TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows App SDK（WinUI 3）。可平滑升级到 1.7.x -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.240923002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VideoPresenter.Shared\VideoPresenter.Shared.csproj" />
  </ItemGroup>

  <!-- 应用图标与标题栏图标 -->
  <ItemGroup>
    <None Remove="Assets\VideoPresenter.ico" />
    <Content Include="Assets\VideoPresenter.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\AppIcon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\AppIcon44.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <AssemblyTitle>视频展台</AssemblyTitle>
    <Description>视频展台 —— 实物展台 / 高拍仪 高清采集与教学批注工具（WinUI 3）</Description>
  </PropertyGroup>

</Project>