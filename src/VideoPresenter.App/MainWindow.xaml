<?xml version="1.0" encoding="utf-8"?>
<!--
    ════════════════════════════════════════════════════════════════════════════
     视频展台 · 主界面（WinUI 3 / Windows App SDK）

     · 布局参考：希沃视频展台（顶部设备栏 → 左侧竖排工具条 → 中央画面 → 右侧素材栏 → 底部状态栏）
     · 视觉体系：系统原生 Fluent —— 全部使用 ThemeResource 系统主题资源

     ★ 配色说明
       本文件中【没有任何硬编码颜色】。所有颜色都来自 WinUI 的系统主题资源：
           ApplicationPageBackgroundThemeBrush   窗口底
           LayerFillColorDefaultBrush            层（半透明，可透出 Mica）
           CardBackgroundFillColorDefaultBrush   卡片 / 面板
           TextFillColorPrimaryBrush             主文本
           TextFillColorSecondaryBrush           次要文本
           DividerStrokeColorDefaultBrush        分隔线
           SolidBackgroundFillColorBaseBrush     状态栏
           AccentFillColorDefaultBrush           强调色（= 系统强调色）
       深浅色切换、强调色变化由 Windows 通知 WinUI 运行时自动完成，
       用户改完系统设置，本窗口立即跟随，无需重启程序。

     ★ 图标
       标题栏使用 Assets\AppIcon.png（构建时由 make-icon 脚本生成）；
       各功能按钮的图标来自系统字体「Segoe Fluent Icons」（Win11 自带）。
    ════════════════════════════════════════════════════════════════════════════
-->
<Window
    x:Class="VideoPresenter.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:VideoPresenter.App.ViewModels"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Transparent">

        <!--
            键盘快捷键（窗口有焦点时生效）：
              Esc / F11 —— 切换全屏
            全局热键（窗口无焦点也生效，注册在 MainWindow.xaml.cs）：
              Ctrl+Alt+P —— 拍照
              Ctrl+Alt+F —— 切换全屏
        -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="FullScreenAccelerator_Invoked"/>
            <KeyboardAccelerator Key="F11" Invoked="FullScreenAccelerator_Invoked"/>
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>    <!-- 标题栏（可拖拽） -->
            <RowDefinition Height="Auto"/>  <!-- 命令栏 -->
            <RowDefinition Height="*"/>     <!-- 内容区 -->
            <RowDefinition Height="Auto"/>  <!-- 状态栏 -->
        </Grid.RowDefinitions>

        <!-- ═══════════════ ① 标题栏 ═══════════════
             右侧留白 140px 给系统绘制的「最小化 / 最大化 / 关闭」按钮，
             这是 WinUI 3 的标准做法：不重绘系统按钮，保持 100% 原生。 -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Padding="16,0,140,0"
              VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/AppIcon.png"
                       Width="20" Height="20"/>
                <TextBlock Text="视频展台"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           VerticalAlignment="Center"/>
                <Border Width="1" Height="14"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                <TextBlock Text="UNSA Studio"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════════ ② 命令栏 ═══════════════ -->
        <Grid Grid.Row="1" Padding="16,0,16,12">
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">

                <TextBlock Text="设备"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>

                <ComboBox x:Name="DeviceSelector"
                          Width="260"
                          PlaceholderText="选择视频展台"
                          ItemsSource="{x:Bind Vm.Devices}"
                          SelectedItem="{x:Bind Vm.SelectedDevice, Mode=TwoWay}"
                          DisplayMemberPath="Name"/>

                <Button Command="{x:Bind Vm.RefreshDevicesCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8"
                        ToolTipService.ToolTip="重新扫描视频设备">
                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                </Button>

                <Border Width="1" Height="20"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                        Margin="4,0"/>

                <!-- 主操作：拍照（使用系统强调色） -->
                <Button Command="{x:Bind Vm.CaptureCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="拍照（Ctrl+Alt+P）">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE722;" FontSize="14"/>
                        <TextBlock Text="拍照"/>
                    </StackPanel>
                </Button>

                <Button Command="{x:Bind Vm.BurstCaptureCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE945;" FontSize="14"/>
                        <TextBlock Text="连拍"/>
                    </StackPanel>
                </Button>

                <Button Command="{x:Bind Vm.TogglePreviewCommand}" Content="暂停 / 继续"/>
            </StackPanel>

            <!-- 右侧：视图模式 -->
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">

                <ToggleButton IsChecked="{x:Bind Vm.IsComparing, Mode=TwoWay}"
                              ToolTipService.ToolTip="对比：左侧选中素材，右侧实时画面">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE8A9;" FontSize="13"/>
                        <TextBlock Text="对比"/>
                    </StackPanel>
                </ToggleButton>

                <ToggleButton IsChecked="{x:Bind Vm.IsAnnotating, Mode=TwoWay}"
                              ToolTipService.ToolTip="批注：在画面上圈画">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE70F;" FontSize="13"/>
                        <TextBlock Text="批注"/>
                    </StackPanel>
                </ToggleButton>

                <ToggleButton IsChecked="{x:Bind Vm.IsTopmost, Mode=TwoWay}"
                              ToolTipService.ToolTip="窗口置顶">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE718;" FontSize="13"/>
                        <TextBlock Text="置顶"/>
                    </StackPanel>
                </ToggleButton>

                <Border Width="1" Height="20"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                        Margin="4,0"/>

                <Button Command="{x:Bind Vm.ToggleFullScreenCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8"
                        ToolTipService.ToolTip="全屏（F11）">
                    <FontIcon Glyph="&#xE740;" FontSize="14"/>
                </Button>

                <Button Command="{x:Bind Vm.ToggleRightPanelCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8"
                        ToolTipService.ToolTip="显示 / 隐藏素材栏">
                    <FontIcon Glyph="&#xE700;" FontSize="14"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══════════════ ③ 内容区 ═══════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76"/>
                <ColumnDefinition Width="*"/>
                <!-- 素材栏宽度改由 Border.Width 驱动（Width 是可动画的 double，
                     GridLength 不能直接做动画），并在 code-behind 里做 220ms 缓动 -->
                <ColumnDefinition x:Name="RightPanelColumn" Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ③-A 左侧竖排工具条（参考希沃布局） -->
            <Border Grid.Column="0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <StackPanel Padding="6,12" Spacing="2">

                    <Button Command="{x:Bind Vm.CaptureCommand}"
                            Background="Transparent" BorderThickness="0"
                            Width="64" Height="58" Padding="0" CornerRadius="4">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE722;" FontSize="18"/>
                            <TextBlock Text="拍照" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{x:Bind Vm.BurstCaptureCommand}"
                            Background="Transparent" BorderThickness="0"
                            Width="64" Height="58" Padding="0" CornerRadius="4">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE945;" FontSize="18"/>
                            <TextBlock Text="连拍" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="RecordButton"
                            Click="Record_Click"
                            Background="Transparent" BorderThickness="0"
                            Width="64" Height="58" Padding="0" CornerRadius="4"
                            ToolTipService.ToolTip="录像：把画面录制为 MP4（H.264）">
                        <StackPanel Spacing="4">
                            <FontIcon x:Name="RecordIcon" Glyph="&#xE714;" FontSize="18"/>
                            <TextBlock x:Name="RecordLabel" Text="录像" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Height="1" Width="40"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                            Margin="0,6"/>

                    <ToggleButton IsChecked="{x:Bind Vm.IsComparing, Mode=TwoWay}"
                                  ToolTipService.ToolTip="对比：左侧选中素材，右侧实时画面"
                                  Background="Transparent" BorderThickness="0"
                                  Width="64" Height="58" Padding="0" CornerRadius="4">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE8A9;" FontSize="18"/>
                            <TextBlock Text="对比" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton IsChecked="{x:Bind Vm.IsAnnotating, Mode=TwoWay}"
                                  ToolTipService.ToolTip="批注：在画面上圈画（支持鼠标 / 触摸 / 手写笔）"
                                  Background="Transparent" BorderThickness="0"
                                  Width="64" Height="58" Padding="0" CornerRadius="4">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE70F;" FontSize="18"/>
                            <TextBlock Text="批注" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <Button Click="Ocr_Click"
                            Background="Transparent" BorderThickness="0"
                            Width="64" Height="58" Padding="0" CornerRadius="4"
                            ToolTipService.ToolTip="OCR：识别画面中的文字（结果可复制）">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE8A5;" FontSize="18"/>
                            <TextBlock Text="OCR" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Click="Rotate_Click"
                            Background="Transparent" BorderThickness="0"
                            Width="64" Height="58" Padding="0" CornerRadius="4"
                            ToolTipService.ToolTip="顺时针旋转 90°（0° → 90° → 180° → 270°）">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE7AD;" FontSize="18"/>
                            <TextBlock Text="旋转" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Height="1" Width="40"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                            Margin="0,6"/>

                    <Button Command="{x:Bind Vm.ToggleFullScreenCommand}"
                            Background="Transparent" BorderThickness="0"
                            Width="64" Height="58" Padding="0" CornerRadius="4"
                            ToolTipService.ToolTip="全屏（Esc / F11）">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE740;" FontSize="18"/>
                            <TextBlock Text="全屏" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Click="OpenSettings_Click"
                            Background="Transparent" BorderThickness="0"
                            Width="64" Height="58" Padding="0" CornerRadius="4"
                            ToolTipService.ToolTip="设置：功能状态、诊断、关于">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE713;" FontSize="18"/>
                            <TextBlock Text="设置" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ③-B 中央实时画面 -->
            <Grid x:Name="PreviewContainer" Grid.Column="1" Background="Black">

                <Image x:Name="PreviewSurface"
                       Stretch="Uniform"
                       Visibility="{x:Bind Vm.PreviewVisibility, Mode=OneWay}">
                    <Image.RenderTransform>
                        <RotateTransform x:Name="PreviewRotate" Angle="0"/>
                    </Image.RenderTransform>
                </Image>

                <!--
                    ══════════ 批注层 ══════════
                    叠在画面之上。注意 Background="Transparent" 是【必须】的：
                    透明且未设 Background 的元素不参与命中测试，
                    鼠标 / 触摸事件一个都收不到。
                -->
                <Canvas x:Name="AnnotationCanvas"
                        Background="Transparent"
                        Visibility="Collapsed"
                        PointerPressed="AnnotationCanvas_PointerPressed"
                        PointerMoved="AnnotationCanvas_PointerMoved"
                        PointerReleased="AnnotationCanvas_PointerReleased"
                        PointerCanceled="AnnotationCanvas_PointerReleased"/>

                <!-- ══════════ 批注工具栏（批注模式下浮现）══════════ -->
                <Border x:Name="AnnotationToolbar"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,24"
                        Padding="10,8"
                        CornerRadius="8"
                        Background="{ThemeResource FlyoutBackgroundBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Border.Shadow>
                        <ThemeShadow/>
                    </Border.Shadow>

                    <StackPanel Orientation="Horizontal" Spacing="10">

                        <!-- 画笔 / 橡皮 -->
                        <ToggleButton x:Name="PenButton"
                                      IsChecked="True"
                                      Click="PenButton_Click"
                                      Width="36" Height="32" Padding="0"
                                      ToolTipService.ToolTip="画笔">
                            <FontIcon Glyph="&#xE70F;" FontSize="14"/>
                        </ToggleButton>

                        <ToggleButton x:Name="EraserButton"
                                      Click="EraserButton_Click"
                                      Width="36" Height="32" Padding="0"
                                      ToolTipService.ToolTip="橡皮（点中哪一笔就删哪一笔）">
                            <FontIcon Glyph="&#xE75C;" FontSize="14"/>
                        </ToggleButton>

                        <Border Width="1" Height="20"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                        <!-- 颜色 -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Click="AnnotationColor_Click" Tag="#FFE53935"
                                    Width="22" Height="22" Padding="0" CornerRadius="11"
                                    Background="#E53935" BorderThickness="1" BorderBrush="#66FFFFFF"
                                    ToolTipService.ToolTip="红色"/>
                            <Button Click="AnnotationColor_Click" Tag="#FFFFB300"
                                    Width="22" Height="22" Padding="0" CornerRadius="11"
                                    Background="#FFB300" BorderThickness="1" BorderBrush="#66FFFFFF"
                                    ToolTipService.ToolTip="橙色"/>
                            <Button Click="AnnotationColor_Click" Tag="#FF43A047"
                                    Width="22" Height="22" Padding="0" CornerRadius="11"
                                    Background="#43A047" BorderThickness="1" BorderBrush="#66FFFFFF"
                                    ToolTipService.ToolTip="绿色"/>
                            <Button Click="AnnotationColor_Click" Tag="#FF1E88E5"
                                    Width="22" Height="22" Padding="0" CornerRadius="11"
                                    Background="#1E88E5" BorderThickness="1" BorderBrush="#66FFFFFF"
                                    ToolTipService.ToolTip="蓝色"/>
                            <Button Click="AnnotationColor_Click" Tag="#FFFFFFFF"
                                    Width="22" Height="22" Padding="0" CornerRadius="11"
                                    Background="#FFFFFF" BorderThickness="1" BorderBrush="#66FFFFFF"
                                    ToolTipService.ToolTip="白色"/>
                        </StackPanel>

                        <Border Width="1" Height="20"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                        <!-- 粗细 -->
                        <Slider x:Name="AnnotationThickness"
                                Width="90"
                                Minimum="2" Maximum="12" Value="4"
                                StepFrequency="1"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="笔迹粗细"/>

                        <Border Width="1" Height="20"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                        <Button Click="UndoAnnotation_Click"
                                Width="36" Height="32" Padding="0"
                                ToolTipService.ToolTip="撤销上一笔">
                            <FontIcon Glyph="&#xE7A7;" FontSize="14"/>
                        </Button>

                        <Button Click="ClearAnnotation_Click"
                                Width="36" Height="32" Padding="0"
                                ToolTipService.ToolTip="清空批注">
                            <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                        </Button>

                        <Button Click="ExitAnnotation_Click" Content="退出批注"/>
                    </StackPanel>
                </Border>

                <!--
                    ══════════ 对比层 ══════════
                    左：选中的素材（静态图）；右：实时画面。
                    叠在最上层，开启时自然遮住单画面预览，无需改 PreviewSurface 的可见性。
                -->
                <Grid x:Name="CompareLayer" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Background="Black">
                        <Image x:Name="CompareSnapshotImage" Stretch="Uniform"/>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="10" Padding="8,3" CornerRadius="4"
                                Background="#66000000">
                            <TextBlock Text="素材" FontSize="11" Foreground="#CCFFFFFF"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Column="1" Background="Black">
                        <Image x:Name="CompareLiveImage" Stretch="Uniform"/>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="10" Padding="8,3" CornerRadius="4"
                                Background="#66000000">
                            <TextBlock Text="实时画面" FontSize="11" Foreground="#CCFFFFFF"/>
                        </Border>
                    </Grid>

                    <Border Grid.Column="0"
                            Width="1"
                            HorizontalAlignment="Right"
                            Background="#44FFFFFF"/>
                </Grid>

                <!-- 未连接时的引导层（颜色同样来自系统主题） -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="14"
                            Visibility="{x:Bind Vm.PreviewHintVisibility, Mode=OneWay}">
                    <FontIcon Glyph="&#xE722;"
                              FontSize="52"
                              Foreground="{ThemeResource TextFillColorDisabledBrush}"/>
                    <TextBlock Text="未连接视频展台"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="在顶部选择设备即可开始预览；若无设备，请检查 USB 连接与驱动"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               HorizontalAlignment="Center"/>

                    <!-- 把日志路径显示出来：万一仍然扫不到设备，用户可以直接把日志发回来 -->
                    <TextBlock Text="{x:Bind Vm.LogFilePathText}"
                               FontSize="10"
                               Margin="0,16,0,0"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="560"
                               Foreground="{ThemeResource TextFillColorDisabledBrush}"/>
                </StackPanel>
            </Grid>

            <!-- ③-C 右侧素材栏 -->
            <Border x:Name="RightPanel"
                    Grid.Column="2"
                    Width="252"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="14,16,10,8">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="拍摄记录"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <Border Padding="7,1" CornerRadius="9"
                                    Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                <TextBlock Text="{x:Bind Vm.SnapshotCountText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="2"
                                    HorizontalAlignment="Right">
                            <Button Command="{x:Bind Vm.DeleteSnapshotCommand}"
                                    Background="Transparent" BorderThickness="0" Padding="7"
                                    ToolTipService.ToolTip="删除选中">
                                <FontIcon Glyph="&#xE74D;" FontSize="13"/>
                            </Button>
                            <Button Command="{x:Bind Vm.ClearSnapshotsCommand}"
                                    Background="Transparent" BorderThickness="0" Padding="7"
                                    ToolTipService.ToolTip="清空全部">
                                <FontIcon Glyph="&#xE894;" FontSize="13"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ListView Grid.Row="1"
                              Margin="8,0,8,8"
                              Background="Transparent"
                              BorderThickness="0"
                              ItemsSource="{x:Bind Vm.Snapshots}"
                              SelectedItem="{x:Bind Vm.SelectedSnapshot, Mode=TwoWay}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:SnapshotItem">
                                <Grid Padding="4" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="88" Height="60"
                                            CornerRadius="4"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                        <Image Source="{x:Bind Thumbnail}"
                                               Stretch="UniformToFill"/>
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                Spacing="3">
                                        <TextBlock Text="{x:Bind FileName}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind DimensionText}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                                            <Run Text="{x:Bind TimeText}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{x:Bind SizeText}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Button Grid.Row="2"
                            Margin="12,0,12,12"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind Vm.OpenFolderCommand}"
                            Content="打开素材文件夹"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════ ④ 状态栏 ═══════════════
             背景使用 SolidBackgroundFillColorBaseBrush（系统主题资源），
             深浅色 / 强调色随系统变化。 -->
        <Grid Grid.Row="3"
              Padding="16,0"
              MinHeight="30"
              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{x:Bind Vm.StatusText, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Vm.DeviceText, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{x:Bind Vm.ResolutionText, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{x:Bind Vm.FpsText, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <!-- ★ 明确告诉用户：配色来自系统 -->
                <Border Width="1" Height="12"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <FontIcon Glyph="&#xE790;" FontSize="11"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="ThemeModeText"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <Border Width="1" Height="12"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                <TextBlock Text="{x:Bind Vm.BootInfoText, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="UNSA Studio · v1.0.0"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
        </Grid>

        <!--
            ═══════════════ 设置对话框 ═══════════════
            为什么要有它：界面上有一部分按钮是「占位」（批注 / 对比 / 录像 / OCR / 旋转），
            用户需要有一个地方能一眼看清【哪些能用、哪些还没做】，
            而不是靠一个个去点、去猜。
        -->
        <ContentDialog x:Name="SettingsDialog"
                       Title="设置"
                       CloseButtonText="关闭"
                       DefaultButton="Close">

            <ScrollViewer MaxHeight="520">
                <StackPanel Spacing="18" MinWidth="460">

                    <!-- ① 关于 -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="关于" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="{x:Bind Vm.VersionText}"
                                   Style="{StaticResource CaptionTextBlockStyle}"/>
                        <TextBlock Text="{x:Bind Vm.BootInfoText}"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <!-- ② 功能状态 -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="功能状态" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="✅ 可用　　🚧 尚未实现"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <ItemsControl ItemsSource="{x:Bind Vm.Features}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FeatureStatus">
                                    <Grid Margin="0,3" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Icon}" FontSize="14"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Name}"
                                                   FontSize="12" Width="76"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind Detail}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ③ 诊断 -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="诊断" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="{x:Bind Vm.LogFilePathText}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Button Content="打开日志文件夹" Click="OpenLogFolder_Click"/>
                    </StackPanel>

                    <!-- ④ 快捷键 -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="快捷键" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="Ctrl+Alt+P　　拍照（全局，窗口无焦点也生效）" FontSize="12"/>
                        <TextBlock Text="Ctrl+Alt+F / Esc / F11　　切换全屏" FontSize="12"/>
                    </StackPanel>

                    <!-- ⑤ 许可 -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="许可" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="UNSA Studio 非商业许可 v1.0：源码公开、禁止商业用途；分发需保留署名与来源。"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                        <Button Content="查看完整许可协议" Click="OpenLicense_Click"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </ContentDialog>
    </Grid>
</Window>