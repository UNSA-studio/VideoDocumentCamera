<!--
    ════════════════════════════════════════════════════════════════════════════
     视频展台 · 主界面（WinUI 3 / Windows App SDK）

     · 布局参考：希沃视频展台（顶部设备栏 → 左侧竖排工具条 → 中央画面 → 右侧素材栏 → 底部状态栏）
     · 视觉体系：系统原生 Fluent —— 全部使用 ThemeResource 系统主题资源

     ★ 配色说明
       本文件中【没有任何硬编码颜色】。所有颜色都来自 WinUI 的系统主题资源：
           ApplicationPageBackgroundThemeBrush   窗口底
           LayerFillColorDefaultBrush            层（半透明，可透出 Mica）
           CardBackgroundFillColorDefaultBrush   卡片 / 面板
           TextFillColorPrimaryBrush             主文本
           TextFillColorSecondaryBrush           次要文本
           DividerStrokeColorDefaultBrush        分隔线
           SolidBackgroundFillColorBaseBrush     状态栏
           AccentFillColorDefaultBrush           强调色（= 系统强调色）
       深浅色切换、强调色变化由 Windows 通知 WinUI 运行时自动完成，
       用户改完系统设置，本窗口立即跟随，无需重启程序。

     ★ 图标
       标题栏使用 Assets\AppIcon.png（构建时由 make-icon 脚本生成）；
       各功能按钮的图标来自系统字体「Segoe Fluent Icons」（Win11 自带）。
    ════════════════════════════════════════════════════════════════════════════
-->
<Window
    x:Class="VideoPresenter.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:VideoPresenter.App.ViewModels"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Transparent">

        <!--
            键盘快捷键（窗口有焦点时生效）：
              Esc / F11 —— 切换全屏
            全局热键（窗口无焦点也生效，注册在 MainWindow.xaml.cs）：
              Ctrl+Alt+P —— 拍照
              Ctrl+Alt+F —— 切换全屏
        -->
        <!--
            ⚠ 这里【不能】用 KeyboardAccelerator 注册 Escape / F11。

            WinUI 3 的 KeyboardAccelerator 会在鼠标（或触摸）悬停到其所属元素时
            自动弹出一个「按键提示气泡」—— 而它注册在 RootGrid 上，覆盖整个窗口，
            于是只要指针移到画面区域就会冒出一个 "Esc" 键盘帽，
            看起来像是程序在画面上乱画东西。

            快捷键改由 MainWindow 的窗口消息（SubclassProc）处理，
            行为一致且不产生任何视觉提示。
        -->

        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>    <!-- 0 标题栏（可拖拽） -->
            <RowDefinition Height="Auto"/>  <!-- 1 命令栏 -->
            <RowDefinition Height="*"/>     <!-- 2 主体（内容区 / 顶部状态栏） -->
            <RowDefinition Height="Auto"/>  <!-- 3 状态栏（底部时） -->
        </Grid.RowDefinitions>

        <!--
            列定义：左右两列默认 Auto（宽 0），只有把状态栏放到左侧 / 右侧时才用得上。
            这样不必为"状态栏换位置"重构整棵 XAML 树 —— 只需在代码里改
            Grid.SetRow / SetColumn 与行列高度，见 ApplyStatusBarPosition()。
        -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>  <!-- 0 左侧状态栏 -->
            <ColumnDefinition Width="*"/>     <!-- 1 主体 -->
            <ColumnDefinition Width="Auto"/>  <!-- 2 右侧状态栏 -->
        </Grid.ColumnDefinitions>

        <!-- ═══════════════ ① 标题栏 ═══════════════
             右侧留白 140px 给系统绘制的「最小化 / 最大化 / 关闭」按钮，
             这是 WinUI 3 的标准做法：不重绘系统按钮，保持 100% 原生。 -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Grid.ColumnSpan="3"
              Padding="16,0,140,0"
              VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                <!-- 左上角不显示任何品牌文字 / 图标（用户要求） -->
            </StackPanel>
        </Grid>

        <!-- ═══════════════ ② 命令栏 ═══════════════ -->
        <Grid Grid.Row="1" Grid.ColumnSpan="3" Padding="16,0,16,12">
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">

                <TextBlock Text="设备"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>

                <ComboBox x:Name="DeviceSelector"
                          Width="260"
                          PlaceholderText="选择视频展台"
                          ItemsSource="{x:Bind Vm.Devices}"
                          SelectedItem="{x:Bind Vm.SelectedDevice, Mode=TwoWay}"
                          DisplayMemberPath="Name"/>

                <Button Command="{x:Bind Vm.RefreshDevicesCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8"
                        ToolTipService.ToolTip="重新扫描视频设备">
                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                </Button>

                <Border Width="1" Height="20"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                        Margin="4,0"/>

                <!-- 主操作：拍照（使用系统强调色） -->
                <Button Command="{x:Bind Vm.CaptureCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="拍照（Ctrl+Alt+P）">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE722;" FontSize="14"/>
                        <TextBlock Text="拍照"/>
                    </StackPanel>
                </Button>

                <Button Command="{x:Bind Vm.BurstCaptureCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE945;" FontSize="14"/>
                        <TextBlock Text="连拍"/>
                    </StackPanel>
                </Button>

                <Button Command="{x:Bind Vm.TogglePreviewCommand}" Content="暂停 / 继续"/>
            </StackPanel>

            <!-- 右侧：视图模式 -->
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">

                <ToggleButton IsChecked="{x:Bind Vm.IsComparing, Mode=TwoWay}"
                              ToolTipService.ToolTip="对比：左侧选中素材，右侧实时画面">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE8A9;" FontSize="13"/>
                        <TextBlock Text="对比"/>
                    </StackPanel>
                </ToggleButton>

                <ToggleButton IsChecked="{x:Bind Vm.IsAnnotating, Mode=TwoWay}"
                              ToolTipService.ToolTip="批注：在画面上圈画">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE70F;" FontSize="13"/>
                        <TextBlock Text="批注"/>
                    </StackPanel>
                </ToggleButton>

                <ToggleButton IsChecked="{x:Bind Vm.IsTopmost, Mode=TwoWay}"
                              ToolTipService.ToolTip="窗口置顶">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE718;" FontSize="13"/>
                        <TextBlock Text="置顶"/>
                    </StackPanel>
                </ToggleButton>

                <Border Width="1" Height="20"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                        Margin="4,0"/>

                <Button Command="{x:Bind Vm.ToggleFullScreenCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8"
                        ToolTipService.ToolTip="全屏（F11）">
                    <FontIcon Glyph="&#xE740;" FontSize="14"/>
                </Button>

                <Button Command="{x:Bind Vm.ToggleRightPanelCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8"
                        ToolTipService.ToolTip="显示 / 隐藏素材栏">
                    <FontIcon Glyph="&#xE700;" FontSize="14"/>
                </Button>

                <Border Width="1" Height="20"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                        Margin="4,0"/>

                <!-- 窗口控制：最小化 / 最大化 / 关闭 -->
                <Button Click="Minimize_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8"
                        ToolTipService.ToolTip="最小化">
                    <FontIcon Glyph="&#xE921;" FontSize="12"/>
                </Button>

                <Button Click="MaximizeRestore_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8"
                        ToolTipService.ToolTip="最大化 / 还原">
                    <FontIcon Glyph="&#xE922;" FontSize="12"/>
                </Button>

                <Button Click="CloseWindow_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8"
                        ToolTipService.ToolTip="关闭">
                    <FontIcon Glyph="&#xE8BB;" FontSize="12"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══════════════ ③ 内容区 ═══════════════ -->
        <Grid x:Name="ContentArea" Grid.Row="2" Grid.ColumnSpan="3">
            <!--
                工具栏可以停靠在上 / 下 / 左 / 右：
                  列：0 = 工具栏（左）  1 = 预览区  2 = 工具栏（右）  3 = 素材栏
                  行：0 = 工具栏（上）  1 = 预览区  2 = 工具栏（下）
                未使用的行列尺寸为 0，所以工具栏只会出现在一个位置。
            -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ToolColLeft" Width="76"/>
                <ColumnDefinition Width="*"/>

                <ColumnDefinition x:Name="ToolColRight" Width="0"/>
                <!-- 素材栏宽度改由 Border.Width 驱动（Width 是可动画的 double，
                     GridLength 不能直接做动画），并在 code-behind 里做 220ms 缓动 -->
                <ColumnDefinition x:Name="RightPanelColumn" Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition x:Name="ToolRowTop" Height="0"/>
                <RowDefinition Height="*"/>
                <RowDefinition x:Name="ToolRowBottom" Height="0"/>
            </Grid.RowDefinitions>

            <!-- ③-A 竖排 / 横排工具条（停靠位置由设置决定） -->
            <Border x:Name="ToolBar"
                    Grid.Column="0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <StackPanel x:Name="ToolBarStack" Padding="6,12" Spacing="2">

                    <Button Command="{x:Bind Vm.CaptureCommand}"
                            Background="Transparent" BorderThickness="0"
                            Width="64" Height="58" Padding="0" CornerRadius="4">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE722;" FontSize="18"/>
                            <TextBlock Text="拍照" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{x:Bind Vm.BurstCaptureCommand}"
                            Background="Transparent" BorderThickness="0"
                            Width="64" Height="58" Padding="0" CornerRadius="4">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE945;" FontSize="18"/>
                            <TextBlock Text="连拍" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="RecordButton"
                            Click="Record_Click"
                            Background="Transparent" BorderThickness="0"
                            Width="64" Height="58" Padding="0" CornerRadius="4"
                            ToolTipService.ToolTip="录像：把画面录制为 MP4（H.264）">
                        <StackPanel Spacing="4">
                            <FontIcon x:Name="RecordIcon" Glyph="&#xE714;" FontSize="18"/>
                            <TextBlock x:Name="RecordLabel" Text="录像" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Height="1" Width="40"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                            Margin="0,6"/>

                    <ToggleButton IsChecked="{x:Bind Vm.IsComparing, Mode=TwoWay}"
                                  ToolTipService.ToolTip="对比：左侧选中素材，右侧实时画面"
                                  Background="Transparent" BorderThickness="0"
                                  Width="64" Height="58" Padding="0" CornerRadius="4">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE8A9;" FontSize="18"/>
                            <TextBlock Text="对比" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton IsChecked="{x:Bind Vm.IsAnnotating, Mode=TwoWay}"
                                  ToolTipService.ToolTip="批注：在画面上圈画（支持鼠标 / 触摸 / 手写笔）"
                                  Background="Transparent" BorderThickness="0"
                                  Width="64" Height="58" Padding="0" CornerRadius="4">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE70F;" FontSize="18"/>
                            <TextBlock Text="批注" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <Button Click="Ocr_Click"
                            Background="Transparent" BorderThickness="0"
                            Width="64" Height="58" Padding="0" CornerRadius="4"
                            ToolTipService.ToolTip="OCR：识别画面中的文字（结果可复制）">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE8A5;" FontSize="18"/>
                            <TextBlock Text="OCR" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Click="Rotate_Click"
                            Background="Transparent" BorderThickness="0"
                            Width="64" Height="58" Padding="0" CornerRadius="4"
                            ToolTipService.ToolTip="顺时针旋转 90°（0° → 90° → 180° → 270°）">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE7AD;" FontSize="18"/>
                            <TextBlock Text="旋转" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Height="1" Width="40"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                            Margin="0,6"/>

                    <Button Command="{x:Bind Vm.ToggleFullScreenCommand}"
                            Background="Transparent" BorderThickness="0"
                            Width="64" Height="58" Padding="0" CornerRadius="4"
                            ToolTipService.ToolTip="全屏（Esc / F11）">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE740;" FontSize="18"/>
                            <TextBlock Text="全屏" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Click="OpenSettings_Click"
                            Background="Transparent" BorderThickness="0"
                            Width="64" Height="58" Padding="0" CornerRadius="4"
                            ToolTipService.ToolTip="设置：功能状态、诊断、关于">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE713;" FontSize="18"/>
                            <TextBlock Text="设置" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ③-B 中央实时画面 -->
            <Grid x:Name="PreviewContainer" Grid.Row="1" Grid.Column="1" Background="Black">

                <Image x:Name="PreviewSurface"
                       Stretch="Uniform"
                       Visibility="{x:Bind Vm.PreviewVisibility, Mode=OneWay}">
                    <Image.RenderTransform>
                        <RotateTransform x:Name="PreviewRotate" Angle="0"/>
                    </Image.RenderTransform>
                </Image>

                <!--
                    ══════════ 批注层 ══════════
                    叠在画面之上。注意 Background="Transparent" 是【必须】的：
                    透明且未设 Background 的元素不参与命中测试，
                    鼠标 / 触摸事件一个都收不到。
                -->
                <!--
                    三分线辅助格（可在设置里开关）。
                    IsHitTestVisible=False：绝不能挡住批注的指针事件。
                -->
                <Grid x:Name="GuidesLayer"
                      Visibility="Collapsed"
                      IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Column="0" Width="1" HorizontalAlignment="Right" Background="#40FFFFFF"/>
                    <Border Grid.Column="1" Width="1" HorizontalAlignment="Right" Background="#40FFFFFF"/>
                    <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="#40FFFFFF"/>
                    <Border Grid.Row="1" Height="1" VerticalAlignment="Bottom" Background="#40FFFFFF"/>
                </Grid>

                <Canvas x:Name="AnnotationCanvas"
                        Background="Transparent"
                        Visibility="Collapsed"
                        PointerPressed="AnnotationCanvas_PointerPressed"
                        PointerMoved="AnnotationCanvas_PointerMoved"
                        PointerReleased="AnnotationCanvas_PointerReleased"
                        PointerCanceled="AnnotationCanvas_PointerReleased"/>

                <!-- ══════════ 批注工具栏（批注模式下浮现）══════════ -->
                <Border x:Name="AnnotationToolbar"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,24"
                        Padding="10,8"
                        CornerRadius="8"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Border.Shadow>
                        <ThemeShadow/>
                    </Border.Shadow>

                    <StackPanel Orientation="Horizontal" Spacing="10">

                        <!-- 画笔 / 橡皮 -->
                        <ToggleButton x:Name="PenButton"
                                      IsChecked="True"
                                      Click="PenButton_Click"
                                      Width="36" Height="32" Padding="0"
                                      ToolTipService.ToolTip="画笔">
                            <FontIcon Glyph="&#xE70F;" FontSize="14"/>
                        </ToggleButton>

                        <ToggleButton x:Name="EraserButton"
                                      Click="EraserButton_Click"
                                      Width="36" Height="32" Padding="0"
                                      ToolTipService.ToolTip="橡皮（点中哪一笔就删哪一笔）">
                            <FontIcon Glyph="&#xE75C;" FontSize="14"/>
                        </ToggleButton>

                        <Border Width="1" Height="20"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                        <!-- 颜色 -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Click="AnnotationColor_Click" Tag="#FFE53935"
                                    Width="22" Height="22" Padding="0" CornerRadius="11"
                                    Background="#E53935" BorderThickness="1" BorderBrush="#66FFFFFF"
                                    ToolTipService.ToolTip="红色"/>
                            <Button Click="AnnotationColor_Click" Tag="#FFFFB300"
                                    Width="22" Height="22" Padding="0" CornerRadius="11"
                                    Background="#FFB300" BorderThickness="1" BorderBrush="#66FFFFFF"
                                    ToolTipService.ToolTip="橙色"/>
                            <Button Click="AnnotationColor_Click" Tag="#FF43A047"
                                    Width="22" Height="22" Padding="0" CornerRadius="11"
                                    Background="#43A047" BorderThickness="1" BorderBrush="#66FFFFFF"
                                    ToolTipService.ToolTip="绿色"/>
                            <Button Click="AnnotationColor_Click" Tag="#FF1E88E5"
                                    Width="22" Height="22" Padding="0" CornerRadius="11"
                                    Background="#1E88E5" BorderThickness="1" BorderBrush="#66FFFFFF"
                                    ToolTipService.ToolTip="蓝色"/>
                            <Button Click="AnnotationColor_Click" Tag="#FFFFFFFF"
                                    Width="22" Height="22" Padding="0" CornerRadius="11"
                                    Background="#FFFFFF" BorderThickness="1" BorderBrush="#66FFFFFF"
                                    ToolTipService.ToolTip="白色"/>
                        </StackPanel>

                        <Border Width="1" Height="20"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                        <!-- 粗细 -->
                        <Slider x:Name="AnnotationThickness"
                                Width="90"
                                Minimum="2" Maximum="12" Value="4"
                                StepFrequency="1"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="笔迹粗细"/>

                        <Border Width="1" Height="20"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                        <Button Click="UndoAnnotation_Click"
                                Width="36" Height="32" Padding="0"
                                ToolTipService.ToolTip="撤销上一笔">
                            <FontIcon Glyph="&#xE7A7;" FontSize="14"/>
                        </Button>

                        <Button Click="ClearAnnotation_Click"
                                Width="36" Height="32" Padding="0"
                                ToolTipService.ToolTip="清空批注">
                            <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                        </Button>

                        <Button Click="ExitAnnotation_Click" Content="退出批注"/>
                    </StackPanel>
                </Border>

                <!--
                    ══════════ 对比层 ══════════
                    左：选中的素材（静态图）；右：实时画面。
                    叠在最上层，开启时自然遮住单画面预览，无需改 PreviewSurface 的可见性。
                -->
                <Grid x:Name="CompareLayer" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Background="Black">
                        <Image x:Name="CompareSnapshotImage" Stretch="Uniform"/>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="10" Padding="8,3" CornerRadius="4"
                                Background="#66000000">
                            <TextBlock Text="素材" FontSize="11" Foreground="#CCFFFFFF"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Column="1" Background="Black">
                        <Image x:Name="CompareLiveImage" Stretch="Uniform"/>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="10" Padding="8,3" CornerRadius="4"
                                Background="#66000000">
                            <TextBlock Text="实时画面" FontSize="11" Foreground="#CCFFFFFF"/>
                        </Border>
                    </Grid>

                    <Border Grid.Column="0"
                            Width="1"
                            HorizontalAlignment="Right"
                            Background="#44FFFFFF"/>
                </Grid>

                <!--
                    未连接时的引导层。
                    ⚠ 这里【必须】自带不透明背景：它叠在纯黑的预览区上，
                    若沿用系统主题文字色（浅色主题 = 深灰字），在黑色画面上根本看不见。
                    现在做成「跟随系统主题的卡片」：卡片底色与文字色都来自系统资源，
                    浅色主题 = 白卡片黑字，深色主题 = 深灰卡片白字，任何情况下都清晰。
                -->
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind Vm.PreviewHintVisibility, Mode=OneWay}"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="34,28"
                        MaxWidth="560">
                    <Border.Shadow>
                        <ThemeShadow/>
                    </Border.Shadow>

                    <StackPanel Spacing="12">
                        <FontIcon Glyph="&#xE722;"
                                  FontSize="44"
                                  HorizontalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <TextBlock Text="未连接视频展台"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                        <TextBlock Text="在顶部选择设备即可开始预览；若无设备，请检查 USB 连接与驱动"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <!-- 设备枚举诊断：把 MF 的原始结果直接摆出来，省去让用户翻日志 -->
                        <TextBlock Text="{x:Bind Vm.DeviceDiagnosticsText, Mode=OneWay}"
                                   FontSize="11"
                                   Margin="0,4,0,0"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Left"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <!-- 把日志路径显示出来：万一仍然扫不到设备，用户可以直接把日志发回来 -->
                        <TextBlock Text="{x:Bind Vm.LogFilePathText}"
                                   FontSize="10"
                                   Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ③-C 右侧素材栏 -->
            <Border x:Name="RightPanel"
                    Grid.Row="1"
                    Grid.Column="3"
                    Width="252"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="14,16,10,8">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="拍摄记录"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <Border Padding="7,1" CornerRadius="9"
                                    Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                <TextBlock Text="{x:Bind Vm.SnapshotCountText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="2"
                                    HorizontalAlignment="Right">
                            <Button Command="{x:Bind Vm.DeleteSnapshotCommand}"
                                    Background="Transparent" BorderThickness="0" Padding="7"
                                    ToolTipService.ToolTip="删除选中">
                                <FontIcon Glyph="&#xE74D;" FontSize="13"/>
                            </Button>
                            <Button Command="{x:Bind Vm.ClearSnapshotsCommand}"
                                    Background="Transparent" BorderThickness="0" Padding="7"
                                    ToolTipService.ToolTip="清空全部">
                                <FontIcon Glyph="&#xE894;" FontSize="13"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ListView Grid.Row="1"
                              Margin="8,0,8,8"
                              Background="Transparent"
                              BorderThickness="0"
                              ItemsSource="{x:Bind Vm.Snapshots}"
                              SelectedItem="{x:Bind Vm.SelectedSnapshot, Mode=TwoWay}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:SnapshotItem">
                                <Grid Padding="4" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="88" Height="60"
                                            CornerRadius="4"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                        <Image Source="{x:Bind Thumbnail}"
                                               Stretch="UniformToFill"/>
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                Spacing="3">
                                        <TextBlock Text="{x:Bind FileName}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind DimensionText}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                                            <Run Text="{x:Bind TimeText}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{x:Bind SizeText}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Button Grid.Row="2"
                            Margin="12,0,12,12"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind Vm.OpenFolderCommand}"
                            Content="打开素材文件夹"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════ ④ 状态栏 ═══════════════
             背景使用 SolidBackgroundFillColorBaseBrush（系统主题资源），
             深浅色 / 强调色随系统变化。 -->
        <Grid x:Name="StatusBar"
              Grid.Row="3"
              Grid.ColumnSpan="3"
              Padding="16,0"
              MinHeight="30"
              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusBarText"
                       Grid.Column="0"
                       Text="{x:Bind Vm.StatusText, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>

            <StackPanel x:Name="StatusBarInfo"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Vm.DeviceText, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{x:Bind Vm.ResolutionText, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{x:Bind Vm.FpsText, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <!-- ★ 明确告诉用户：配色来自系统 -->
                <Border Width="1" Height="12"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <FontIcon Glyph="&#xE790;" FontSize="11"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="ThemeModeText"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <Border Width="1" Height="12"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                <TextBlock Text="{x:Bind Vm.BootInfoText, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <!-- 右下角不显示工作室名（用户要求去掉） -->
            </StackPanel>
        </Grid>

        <!--
            ═══════════════ 设置浮层（自绘，非 ContentDialog）═══════════════

            为什么不用 ContentDialog：
              ① ContentDialog 每次 ShowAsync 复用的是同一份内容元素，
                 而 XAML 的过渡动画只在元素【首次加载】时播放 ——
                 所以第二次打开起就完全没有动画，观感是"硬邦邦地弹出来"。
              ② ContentDialog 有固定的宽度上限，放不下分组较多的设置项。

            自绘浮层：动画由 Storyboard 显式驱动（遮罩淡入 + 卡片上浮放大），
            每次打开都播放；宽度与分组布局完全可控。
        -->
        <Grid x:Name="SettingsOverlay"
              Grid.Row="0"
              Grid.RowSpan="4"
              Canvas.ZIndex="100"
              Visibility="Collapsed"
              Opacity="0">

            <!-- 遮罩：点击空白处关闭 -->
            <Rectangle Fill="#66000000" Tapped="SettingsOverlay_Tapped"/>

            <!-- 卡片本体：动画目标是它的 CompositeTransform -->
            <Border x:Name="SettingsCard"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="780"
                    MaxHeight="680"
                    CornerRadius="12"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="SettingsCardTransform"/>
                </Border.RenderTransform>
                <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                <Border.Shadow>
                    <ThemeShadow/>
                </Border.Shadow>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 标题栏 -->
                    <Grid Grid.Row="0" Padding="24,18,14,10">
                        <TextBlock Text="设置"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="8"
                                Click="CloseSettings_Click"
                                ToolTipService.ToolTip="关闭（Esc）">
                            <FontIcon Glyph="&#xE711;" FontSize="14"/>
                        </Button>
                    </Grid>

                    <!-- 设置正文 -->
                    <ScrollViewer Grid.Row="1"
                                  Padding="24,0,24,8"
                                  VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="18">

                    <!-- ① 关于 -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="关于" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="{x:Bind Vm.VersionText}"
                                   Style="{StaticResource CaptionTextBlockStyle}"/>
                        <TextBlock Text="{x:Bind Vm.BootInfoText}"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <!-- ══════════ ① 设置项（真正可操作）══════════ -->

                    <StackPanel Spacing="8">
                        <TextBlock Text="常规" Style="{StaticResource BodyStrongTextBlockStyle}"/>

                        <ToggleSwitch Header="启动时自动全屏"
                                      OnContent="开" OffContent="关"
                                      IsOn="{x:Bind Vm.Settings.StartFullScreen, Mode=TwoWay}"/>

                        <ToggleSwitch Header="自动连接唯一设备"
                                      OnContent="开" OffContent="关"
                                      IsOn="{x:Bind Vm.Settings.AutoConnectSingleDevice, Mode=TwoWay}"/>

                        <ToggleSwitch Header="自动检测设备插拔"
                                      OnContent="开" OffContent="关"
                                      IsOn="{x:Bind Vm.Settings.AutoDetectDevices, Mode=TwoWay}"/>

                        <ToggleSwitch Header="状态栏显示启动耗时"
                                      OnContent="开" OffContent="关"
                                      IsOn="{x:Bind Vm.Settings.ShowBootTime, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="拍照" Style="{StaticResource BodyStrongTextBlockStyle}"/>

                        <ToggleSwitch Header="照片格式"
                                      OnContent="JPEG（体积小）" OffContent="PNG（无损）"
                                      IsOn="{x:Bind Vm.Settings.IsJpeg, Mode=TwoWay}"/>

                        <Slider Header="JPEG 质量"
                                Minimum="60" Maximum="100" StepFrequency="1"
                                Value="{x:Bind Vm.Settings.JpegQuality, Mode=TwoWay}"
                                IsEnabled="{x:Bind Vm.Settings.IsJpeg, Mode=OneWay}"/>

                        <ToggleSwitch Header="拍照后复制到剪贴板"
                                      OnContent="开" OffContent="关"
                                      IsOn="{x:Bind Vm.Settings.CopyPhotoToClipboard, Mode=TwoWay}"/>

                        <StackPanel Spacing="4">
                            <TextBlock Text="保存目录" FontSize="12"/>
                            <TextBlock Text="{x:Bind Vm.Settings.PhotoFolderDisplay, Mode=OneWay}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="选择文件夹…" Click="PickPhotoFolder_Click"/>
                                <Button Content="恢复默认" Click="ResetPhotoFolder_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="录像" Style="{StaticResource BodyStrongTextBlockStyle}"/>

                        <ComboBox x:Name="RecordFpsBox"
                                  Header="帧率"
                                  MinWidth="200" HorizontalAlignment="Left"
                                  SelectionChanged="RecordFps_SelectionChanged">
                            <ComboBoxItem Content="15 fps"/>
                            <ComboBoxItem Content="30 fps"/>
                            <ComboBoxItem Content="60 fps"/>
                        </ComboBox>

                        <ComboBox x:Name="RecordBitrateBox"
                                  Header="码率"
                                  MinWidth="200" HorizontalAlignment="Left"
                                  SelectionChanged="RecordBitrate_SelectionChanged">
                            <ComboBoxItem Content="4 Mbps"/>
                            <ComboBoxItem Content="8 Mbps"/>
                            <ComboBoxItem Content="16 Mbps"/>
                            <ComboBoxItem Content="24 Mbps"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="批注" Style="{StaticResource BodyStrongTextBlockStyle}"/>

                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="默认颜色" FontSize="12" VerticalAlignment="Center"/>
                            <Button Click="SettingsInkColor_Click" Tag="#FFE53935"
                                    Width="24" Height="24" Padding="0" CornerRadius="12"
                                    Background="#E53935" BorderThickness="1" BorderBrush="#66FFFFFF"
                                    ToolTipService.ToolTip="红色"/>
                            <Button Click="SettingsInkColor_Click" Tag="#FFFFB300"
                                    Width="24" Height="24" Padding="0" CornerRadius="12"
                                    Background="#FFB300" BorderThickness="1" BorderBrush="#66FFFFFF"
                                    ToolTipService.ToolTip="橙色"/>
                            <Button Click="SettingsInkColor_Click" Tag="#FF43A047"
                                    Width="24" Height="24" Padding="0" CornerRadius="12"
                                    Background="#43A047" BorderThickness="1" BorderBrush="#66FFFFFF"
                                    ToolTipService.ToolTip="绿色"/>
                            <Button Click="SettingsInkColor_Click" Tag="#FF1E88E5"
                                    Width="24" Height="24" Padding="0" CornerRadius="12"
                                    Background="#1E88E5" BorderThickness="1" BorderBrush="#66FFFFFF"
                                    ToolTipService.ToolTip="蓝色"/>
                            <Button Click="SettingsInkColor_Click" Tag="#FFFFFFFF"
                                    Width="24" Height="24" Padding="0" CornerRadius="12"
                                    Background="#FFFFFF" BorderThickness="1" BorderBrush="#66FFFFFF"
                                    ToolTipService.ToolTip="白色"/>
                        </StackPanel>

                        <Slider Header="默认粗细"
                                Minimum="2" Maximum="12" StepFrequency="1"
                                Value="{x:Bind Vm.Settings.InkThickness, Mode=TwoWay}"/>

                        <ToggleSwitch Header="截图包含批注"
                                      OnContent="开" OffContent="关"
                                      IsOn="{x:Bind Vm.Settings.BurnAnnotationsIntoPhoto, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="全局热键" Style="{StaticResource BodyStrongTextBlockStyle}"/>

                        <ToggleSwitch Header="Ctrl+Alt+P 拍照"
                                      OnContent="启用" OffContent="禁用"
                                      IsOn="{x:Bind Vm.Settings.HotkeyCaptureEnabled, Mode=TwoWay}"/>

                        <ToggleSwitch Header="Ctrl+Alt+F 切换全屏"
                                      OnContent="启用" OffContent="禁用"
                                      IsOn="{x:Bind Vm.Settings.HotkeyFullScreenEnabled, Mode=TwoWay}"/>
                    </StackPanel>

                    <!-- ③ 诊断 -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="诊断" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="{x:Bind Vm.LogFilePathText}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Button Content="打开日志文件夹" Click="OpenLogFolder_Click"/>
                    </StackPanel>

                    <!-- ④ 快捷键 -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="快捷键" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="Ctrl+Alt+P　　拍照（全局，窗口无焦点也生效）" FontSize="12"/>
                        <TextBlock Text="Ctrl+Alt+F / Esc / F11　　切换全屏" FontSize="12"/>
                    </StackPanel>

                    <!-- ⑤ 许可 -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="许可" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="源代码适用 PolyForm Noncommercial License 1.0.0：源码公开、禁止商业用途；分发需保留许可条款与署名声明。学校等教育机构的使用明确被允许。"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                        <Button Content="查看完整许可协议" Click="OpenLicense_Click"/>
                    </StackPanel>

                    <!-- ══════════ 拍照（进阶）══════════ -->

                    <StackPanel Spacing="8">
                        <TextBlock Text="拍照（进阶）" Style="{StaticResource BodyStrongTextBlockStyle}"/>

                        <StackPanel Spacing="4">
                            <TextBlock Text="文件名前缀" FontSize="12"/>
                            <TextBox Text="{x:Bind Vm.Settings.FileNamePrefix, Mode=TwoWay}"
                                     PlaceholderText="展台"
                                     MaxLength="32"/>
                        </StackPanel>

                        <Slider Header="连拍张数"
                                Minimum="2" Maximum="9" StepFrequency="1"
                                Value="{x:Bind Vm.Settings.BurstCount, Mode=TwoWay}"/>

                        <ToggleSwitch Header="拍照提示音"
                                      OnContent="开" OffContent="关"
                                      IsOn="{x:Bind Vm.Settings.CaptureSound, Mode=TwoWay}"/>

                        <ToggleSwitch Header="拍完自动打开文件夹"
                                      OnContent="开" OffContent="关"
                                      IsOn="{x:Bind Vm.Settings.OpenFolderAfterCapture, Mode=TwoWay}"/>
                    </StackPanel>

                    <!-- ══════════ 录像（进阶）══════════ -->

                    <StackPanel Spacing="8">
                        <TextBlock Text="录像（进阶）" Style="{StaticResource BodyStrongTextBlockStyle}"/>

                        <Slider Header="单次录像时长上限（分钟；0 = 不限）"
                                Minimum="0" Maximum="180" StepFrequency="5"
                                Value="{x:Bind Vm.Settings.RecordMaxMinutes, Mode=TwoWay}"/>
                    </StackPanel>

                    <!-- ══════════ 批注（进阶）══════════ -->

                    <StackPanel Spacing="8">
                        <TextBlock Text="批注（进阶）" Style="{StaticResource BodyStrongTextBlockStyle}"/>

                        <Slider Header="橡皮擦大小"
                                Minimum="6" Maximum="60" StepFrequency="1"
                                Value="{x:Bind Vm.Settings.EraserThickness, Mode=TwoWay}"/>

                        <TextBlock Text="橡皮擦为局部擦除：擦到哪里，哪一段笔迹消失（不是整笔删除）。"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>

                    <!-- ══════════ 界面 ══════════ -->

                    <StackPanel Spacing="8">
                        <TextBlock Text="界面" Style="{StaticResource BodyStrongTextBlockStyle}"/>

                        <ComboBox x:Name="ToolbarPosBox"
                                  Header="工具栏位置"
                                  MinWidth="200" HorizontalAlignment="Left"
                                  SelectionChanged="ToolbarPos_SelectionChanged">
                            <ComboBoxItem Content="左侧（默认）"/>
                            <ComboBoxItem Content="右侧"/>
                            <ComboBoxItem Content="顶部"/>
                            <ComboBoxItem Content="底部"/>
                        </ComboBox>

                        <ComboBox x:Name="StatusBarPosBox"
                                  Header="状态栏位置"
                                  MinWidth="200" HorizontalAlignment="Left"
                                  SelectionChanged="StatusBarPos_SelectionChanged">
                            <ComboBoxItem Content="底部（默认）"/>
                            <ComboBoxItem Content="顶部"/>
                            <ComboBoxItem Content="左侧"/>
                            <ComboBoxItem Content="右侧"/>
                        </ComboBox>

                        <ToggleSwitch Header="启动时展开素材栏"
                                      OnContent="开" OffContent="关"
                                      IsOn="{x:Bind Vm.Settings.RightPanelOpenByDefault, Mode=TwoWay}"/>

                        <ToggleSwitch Header="显示三分线辅助格"
                                      OnContent="开" OffContent="关"
                                      IsOn="{x:Bind Vm.Settings.ShowGuides, Mode=TwoWay}"/>
                    </StackPanel>

                    <!-- ══════════ 设备 ══════════ -->

                    <StackPanel Spacing="8">
                        <TextBlock Text="设备" Style="{StaticResource BodyStrongTextBlockStyle}"/>

                        <ToggleSwitch Header="记住上次使用的设备"
                                      OnContent="开" OffContent="关"
                                      IsOn="{x:Bind Vm.Settings.RememberLastDevice, Mode=TwoWay}"/>

                        <ComboBox x:Name="DefaultDeviceBox"
                                  Header="默认设备（下次自动连接它）"
                                  MinWidth="240" HorizontalAlignment="Left"
                                  ItemsSource="{x:Bind Vm.Devices}"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="DefaultDevice_SelectionChanged"/>

                        <TextBlock Text="{x:Bind Vm.LastDeviceText, Mode=OneWay}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>

                    <!-- ══════════ 启动 ══════════ -->

                    <StackPanel Spacing="8">
                        <TextBlock Text="启动" Style="{StaticResource BodyStrongTextBlockStyle}"/>

                        <ToggleSwitch Header="随 Windows 启动"
                                      OnContent="开" OffContent="关"
                                      Toggled="AutoStart_Toggled"
                                      IsOn="{x:Bind Vm.Settings.AutoStartWithWindows, Mode=TwoWay}"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

                    <!-- 底部按钮 -->
                    <Grid Grid.Row="2" Padding="24,10,24,18">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Right">
                            <Button Content="恢复默认设置" Click="ResetAllSettings_Click"/>
                            <Button Content="完成"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="CloseSettings_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>