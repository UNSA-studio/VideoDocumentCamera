<?xml version="1.0" encoding="utf-8"?>
<!--
    ════════════════════════════════════════════════════════════════════════════
     视频展台 · 主界面（WinUI 3 / Windows App SDK）

     · 布局参考：希沃视频展台（顶部设备栏 → 左侧竖排工具条 → 中央画面 → 右侧素材栏 → 底部状态栏）
     · 视觉体系：系统原生 Fluent —— 全部使用 ThemeResource 系统主题资源

     ★ 配色说明
       本文件中【没有任何硬编码颜色】。所有颜色都来自 WinUI 的系统主题资源：
           ApplicationPageBackgroundThemeBrush   窗口底
           LayerFillColorDefaultBrush            层（半透明，可透出 Mica）
           CardBackgroundFillColorDefaultBrush   卡片 / 面板
           TextFillColorPrimaryBrush             主文本
           TextFillColorSecondaryBrush           次要文本
           DividerStrokeColorDefaultBrush        分隔线
           SolidBackgroundFillColorBaseBrush     状态栏
           AccentFillColorDefaultBrush           强调色（= 系统强调色）
       深浅色切换、强调色变化由 Windows 通知 WinUI 运行时自动完成，
       用户改完系统设置，本窗口立即跟随，无需重启程序。

     ★ 图标
       标题栏使用 Assets\AppIcon.png（构建时由 make-icon 脚本生成）；
       各功能按钮的图标来自系统字体「Segoe Fluent Icons」（Win11 自带）。
    ════════════════════════════════════════════════════════════════════════════
-->
<Window
    x:Class="VideoPresenter.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:VideoPresenter.App.ViewModels"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Transparent">

        <!--
            键盘快捷键（窗口有焦点时生效）：
              Esc / F11 —— 切换全屏
            全局热键（窗口无焦点也生效，注册在 MainWindow.xaml.cs）：
              Ctrl+Alt+P —— 拍照
              Ctrl+Alt+F —— 切换全屏
        -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="FullScreenAccelerator_Invoked"/>
            <KeyboardAccelerator Key="F11" Invoked="FullScreenAccelerator_Invoked"/>
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>    <!-- 标题栏（可拖拽） -->
            <RowDefinition Height="Auto"/>  <!-- 命令栏 -->
            <RowDefinition Height="*"/>     <!-- 内容区 -->
            <RowDefinition Height="Auto"/>  <!-- 状态栏 -->
        </Grid.RowDefinitions>

        <!-- ═══════════════ ① 标题栏 ═══════════════
             右侧留白 140px 给系统绘制的「最小化 / 最大化 / 关闭」按钮，
             这是 WinUI 3 的标准做法：不重绘系统按钮，保持 100% 原生。 -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Padding="16,0,140,0"
              VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/AppIcon.png"
                       Width="20" Height="20"/>
                <TextBlock Text="视频展台"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           VerticalAlignment="Center"/>
                <Border Width="1" Height="14"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                <TextBlock Text="UNSA Studio"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════════ ② 命令栏 ═══════════════ -->
        <Grid Grid.Row="1" Padding="16,0,16,12">
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">

                <TextBlock Text="设备"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>

                <ComboBox x:Name="DeviceSelector"
                          Width="260"
                          PlaceholderText="选择视频展台"
                          ItemsSource="{x:Bind Vm.Devices}"
                          SelectedItem="{x:Bind Vm.SelectedDevice, Mode=TwoWay}"
                          DisplayMemberPath="Name"/>

                <Button Command="{x:Bind Vm.RefreshDevicesCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8"
                        ToolTipService.ToolTip="重新扫描视频设备">
                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                </Button>

                <Border Width="1" Height="20"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                        Margin="4,0"/>

                <!-- 主操作：拍照（使用系统强调色） -->
                <Button Command="{x:Bind Vm.CaptureCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="拍照（Ctrl+Alt+P）">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE722;" FontSize="14"/>
                        <TextBlock Text="拍照"/>
                    </StackPanel>
                </Button>

                <Button Command="{x:Bind Vm.BurstCaptureCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE945;" FontSize="14"/>
                        <TextBlock Text="连拍"/>
                    </StackPanel>
                </Button>

                <Button Command="{x:Bind Vm.TogglePreviewCommand}" Content="暂停 / 继续"/>
            </StackPanel>

            <!-- 右侧：视图模式 -->
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">

                <ToggleButton IsChecked="{x:Bind Vm.IsComparing, Mode=TwoWay}"
                              ToolTipService.ToolTip="对比">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE8A9;" FontSize="13"/>
                        <TextBlock Text="对比"/>
                    </StackPanel>
                </ToggleButton>

                <ToggleButton IsChecked="{x:Bind Vm.IsAnnotating, Mode=TwoWay}"
                              ToolTipService.ToolTip="批注">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE70F;" FontSize="13"/>
                        <TextBlock Text="批注"/>
                    </StackPanel>
                </ToggleButton>

                <ToggleButton IsChecked="{x:Bind Vm.IsTopmost, Mode=TwoWay}"
                              ToolTipService.ToolTip="窗口置顶">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE718;" FontSize="13"/>
                        <TextBlock Text="置顶"/>
                    </StackPanel>
                </ToggleButton>

                <Border Width="1" Height="20"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                        Margin="4,0"/>

                <Button Command="{x:Bind Vm.ToggleFullScreenCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8"
                        ToolTipService.ToolTip="全屏（F11）">
                    <FontIcon Glyph="&#xE740;" FontSize="14"/>
                </Button>

                <Button Command="{x:Bind Vm.ToggleRightPanelCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8"
                        ToolTipService.ToolTip="显示 / 隐藏素材栏">
                    <FontIcon Glyph="&#xE700;" FontSize="14"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══════════════ ③ 内容区 ═══════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76"/>
                <ColumnDefinition Width="*"/>
                <!-- 素材栏宽度由代码联动（ColumnDefinition 不是 FrameworkElement，
                     x:Bind 不支持，详见 MainWindow.xaml.cs） -->
                <ColumnDefinition x:Name="RightPanelColumn" Width="252"/>
            </Grid.ColumnDefinitions>

            <!-- ③-A 左侧竖排工具条（参考希沃布局） -->
            <Border Grid.Column="0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <StackPanel Padding="6,12" Spacing="2">

                    <Button Command="{x:Bind Vm.CaptureCommand}"
                            Background="Transparent" BorderThickness="0"
                            Width="64" Height="58" Padding="0" CornerRadius="4">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE722;" FontSize="18"/>
                            <TextBlock Text="拍照" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{x:Bind Vm.BurstCaptureCommand}"
                            Background="Transparent" BorderThickness="0"
                            Width="64" Height="58" Padding="0" CornerRadius="4">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE945;" FontSize="18"/>
                            <TextBlock Text="连拍" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button IsEnabled="False"
                            Background="Transparent" BorderThickness="0"
                            Width="64" Height="58" Padding="0" CornerRadius="4"
                            ToolTipService.ToolTip="即将推出">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE714;" FontSize="18"/>
                            <TextBlock Text="录像" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Height="1" Width="40"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                            Margin="0,6"/>

                    <ToggleButton IsChecked="{x:Bind Vm.IsComparing, Mode=TwoWay}"
                                  Background="Transparent" BorderThickness="0"
                                  Width="64" Height="58" Padding="0" CornerRadius="4">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE8A9;" FontSize="18"/>
                            <TextBlock Text="对比" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton IsChecked="{x:Bind Vm.IsAnnotating, Mode=TwoWay}"
                                  Background="Transparent" BorderThickness="0"
                                  Width="64" Height="58" Padding="0" CornerRadius="4">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE70F;" FontSize="18"/>
                            <TextBlock Text="批注" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <Button IsEnabled="False"
                            Background="Transparent" BorderThickness="0"
                            Width="64" Height="58" Padding="0" CornerRadius="4"
                            ToolTipService.ToolTip="即将推出">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE8A5;" FontSize="18"/>
                            <TextBlock Text="OCR" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button IsEnabled="False"
                            Background="Transparent" BorderThickness="0"
                            Width="64" Height="58" Padding="0" CornerRadius="4"
                            ToolTipService.ToolTip="即将推出">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE7AD;" FontSize="18"/>
                            <TextBlock Text="旋转" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Height="1" Width="40"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                            Margin="0,6"/>

                    <Button Command="{x:Bind Vm.ToggleFullScreenCommand}"
                            Background="Transparent" BorderThickness="0"
                            Width="64" Height="58" Padding="0" CornerRadius="4">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE740;" FontSize="18"/>
                            <TextBlock Text="全屏" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ③-B 中央实时画面 -->
            <Grid Grid.Column="1" Background="Black">

                <Image x:Name="PreviewSurface"
                       Stretch="Uniform"
                       Visibility="{x:Bind Vm.PreviewVisibility, Mode=OneWay}"/>

                <!-- 未连接时的引导层（颜色同样来自系统主题） -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="14"
                            Visibility="{x:Bind Vm.PreviewHintVisibility, Mode=OneWay}">
                    <FontIcon Glyph="&#xE722;"
                              FontSize="52"
                              Foreground="{ThemeResource TextFillColorDisabledBrush}"/>
                    <TextBlock Text="未连接视频展台"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="在顶部选择设备即可开始预览；若无设备，请检查 USB 连接与驱动"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               HorizontalAlignment="Center"/>

                    <!-- 把日志路径显示出来：万一仍然扫不到设备，用户可以直接把日志发回来 -->
                    <TextBlock Text="{x:Bind Vm.LogFilePathText}"
                               FontSize="10"
                               Margin="0,16,0,0"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="560"
                               Foreground="{ThemeResource TextFillColorDisabledBrush}"/>
                </StackPanel>
            </Grid>

            <!-- ③-C 右侧素材栏 -->
            <Border Grid.Column="2"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    Visibility="{x:Bind Vm.IsRightPanelOpen, Mode=OneWay}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="14,16,10,8">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="拍摄记录"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <Border Padding="7,1" CornerRadius="9"
                                    Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                <TextBlock Text="{x:Bind Vm.SnapshotCountText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="2"
                                    HorizontalAlignment="Right">
                            <Button Command="{x:Bind Vm.DeleteSnapshotCommand}"
                                    Background="Transparent" BorderThickness="0" Padding="7"
                                    ToolTipService.ToolTip="删除选中">
                                <FontIcon Glyph="&#xE74D;" FontSize="13"/>
                            </Button>
                            <Button Command="{x:Bind Vm.ClearSnapshotsCommand}"
                                    Background="Transparent" BorderThickness="0" Padding="7"
                                    ToolTipService.ToolTip="清空全部">
                                <FontIcon Glyph="&#xE894;" FontSize="13"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ListView Grid.Row="1"
                              Margin="8,0,8,8"
                              Background="Transparent"
                              BorderThickness="0"
                              ItemsSource="{x:Bind Vm.Snapshots}"
                              SelectedItem="{x:Bind Vm.SelectedSnapshot, Mode=TwoWay}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:SnapshotItem">
                                <Grid Padding="4" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="88" Height="60"
                                            CornerRadius="4"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                        <Image Source="{x:Bind Thumbnail}"
                                               Stretch="UniformToFill"/>
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                Spacing="3">
                                        <TextBlock Text="{x:Bind FileName}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind DimensionText}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                                            <Run Text="{x:Bind TimeText}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{x:Bind SizeText}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Button Grid.Row="2"
                            Margin="12,0,12,12"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind Vm.OpenFolderCommand}"
                            Content="打开素材文件夹"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════ ④ 状态栏 ═══════════════
             背景使用 SolidBackgroundFillColorBaseBrush（系统主题资源），
             深浅色 / 强调色随系统变化。 -->
        <Grid Grid.Row="3"
              Padding="16,0"
              MinHeight="30"
              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{x:Bind Vm.StatusText, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Vm.DeviceText, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{x:Bind Vm.ResolutionText, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{x:Bind Vm.FpsText, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <!-- ★ 明确告诉用户：配色来自系统 -->
                <Border Width="1" Height="12"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <FontIcon Glyph="&#xE790;" FontSize="11"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="ThemeModeText"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <Border Width="1" Height="12"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                <TextBlock Text="{x:Bind Vm.BootInfoText, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="UNSA Studio · v1.0.0"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>