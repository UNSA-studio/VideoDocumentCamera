<?xml version="1.0" encoding="utf-8"?>
<!--
    VideoPresenter · MSI 打包工程（WiX v4）
    开发商：UNSA Studio

    构建：
        dotnet build installer/wix/VideoPresenter.Msi.wixproj -c Release -p:Platform=x64
    或在仓库根目录执行：
        ./build/build.ps1 -Package Msi
-->
<Project Sdk="WixToolset.Sdk/4.0.5">

    <PropertyGroup>
        <!-- ── 由 build.ps1 覆写；此处提供可直接编译的默认值 ── -->
        <VpVersion Condition="'$(VpVersion)' == ''">1.0.0</VpVersion>
        <VpPublishDir Condition="'$(VpPublishDir)' == ''">$(MSBuildThisFileDirectory)..\..\dist\app\</VpPublishDir>
        <VpIconPath Condition="'$(VpIconPath)' == ''">$(MSBuildThisFileDirectory)..\..\src\VideoPresenter.App\Assets\VideoPresenter.ico</VpIconPath>
        <!-- 许可协议 RTF：由 build.ps1 从 installer/EULA.txt 转换生成 -->
        <VpEulaRtf Condition="'$(VpEulaRtf)' == ''">$(MSBuildThisFileDirectory)..\..\installer\EULA.rtf</VpEulaRtf>

        <OutputName>视频展台-$(VpVersion)-x64</OutputName>
        <OutputType>Package</OutputType>
        <Platform Condition="'$(Platform)' == ''">x64</Platform>
        <InstallerPlatform>x64</InstallerPlatform>

        <OutputPath>$(MSBuildThisFileDirectory)..\..\dist\</OutputPath>
        <IntermediateOutputPath>$(MSBuildThisFileDirectory)..\..\build\obj\Msi\$(Configuration)\</IntermediateOutputPath>

        <SuppressIces>ICE61</SuppressIces>
        <DefineConstants>VpVersion=$(VpVersion);VpPublishDir=$(VpPublishDir);VpIconPath=$(VpIconPath);VpEulaRtf=$(VpEulaRtf)</DefineConstants>
    </PropertyGroup>

    <!--
        注意：这里【不能】再显式列一遍 .wxs 文件。

        WixToolset.Sdk 会自动包含项目目录下的所有 .wxs（包括 build.ps1 生成的
        GeneratedFiles.wxs）。显式重复声明会让 Product.wxs 被编译两次，
        从而出现两个 entry section（两个 <Package>），报：
            error WIX0089: Multiple entry sections '*' and '*' found.
            error WIX0091: Duplicate symbol 'Property:ProductCode' ...
    -->

<ItemGroup>
        <!--
            安装向导 UI（WiX v4 的 UI 扩展）。

            没有它，MSI 双击后只会显示一个进度条，没有欢迎页 / 许可协议页 /
            安装路径选择 —— 也就是说 WixUILicenseRtf 也不会生效。
        -->
        <PackageReference Include="WixToolset.UI.wixext" Version="4.0.5" />
    </ItemGroup>

</Project>