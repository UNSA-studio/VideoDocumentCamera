<?xml version="1.0" encoding="utf-8"?>
<!--
    ============================================================================
     视频展台 · MSI 安装包定义（WiX v4）
     开发商 / 制造商：UNSA Studio

     安装布局
     ────────────────────────────────────────────────────────────────────────
       %ProgramFiles%\UNSA Studio\视频展台\
           VideoPresenter.Launcher.exe    ← 桌面/开始菜单快捷方式指向它
           VideoPresenter.exe
           …（self-contained 运行时）

     说明
     ────────────────────────────────────────────────────────────────────────
       * 快捷方式必须指向【启动器】而不是主程序 —— 这是"1 秒启动"体验的入口；
       * 采用 <Files Include> 通配收集发布目录，新增文件无需修改本文件。
    ============================================================================
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

    <Package Name="视频展台"
             Manufacturer="UNSA Studio"
             Version="$(VpVersion)"
             UpgradeCode="{2F1C9E70-4B31-4A88-9C6E-5D0A7B3E8F42}"
             Scope="perMachine"
             Compressed="yes"
             InstallerVersion="500"
             Language="2052"
             Codepage="936">

        <SummaryInformation
            Description="视频展台 安装程序（UNSA Studio）"
            Manufacturer="UNSA Studio"/>

        <!-- 升级策略：同版本可覆盖安装；降级给出明确提示 -->
        <MajorUpgrade DowngradeErrorMessage="已安装更高版本的「视频展台」，请先卸载后再安装当前版本。"
                      AllowSameVersionUpgrades="yes"/>
        <MediaTemplate EmbedCab="yes"/>

        <!-- ══════════ 安装界面 ══════════

             此前这里没有引用 WiX 的 UI 扩展，后果是：
             双击 MSI 只会看到一个进度条 —— 没有欢迎页、没有许可协议页、
             也没有安装路径选择。现在补上标准的 InstallDir 向导。

             许可页的 RTF 由 build.ps1 从 installer/EULA.txt 自动转换生成
             （WiX 的 WixUILicenseRtf 只接受 RTF 格式）。
        -->
        <ui:WixUI Id="WixUI_InstallDir"/>
        <WixVariable Id="WixUILicenseRtf" Value="$(VpEulaRtf)"/>
        <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER"/>

        <!-- 程序与控制面板图标 -->
        <Icon Id="VpAppIcon" SourceFile="$(VpIconPath)"/>
        <Property Id="ARPPRODUCTICON" Value="VpAppIcon"/>
        <!--
            注意：不要在这里定义 ARPNOMODIFY —— WixUI_InstallDir 的 wixlib 里
            已经声明了它，重复定义会报：
                error WIX0091: Duplicate symbol 'Property:ARPNOMODIFY' found
        -->
        <Property Id="ARPHELPLINK" Value="https://www.unsa.studio/"/>
        <Property Id="ARPCOMMENTS" Value="视频展台 —— 实物展台 / 高拍仪高清采集与教学批注"/>

        <!-- ══════════ 目录结构 ══════════ -->
        <StandardDirectory Id="ProgramFiles64Folder">
            <Directory Id="MANUFACTURERFOLDER" Name="UNSA Studio">
                <!--
                    安装目录刻意使用【英文】且简短：
                      C:\Program Files\UNSA Studio\vdc\

                    · vdc = VideoDocumentCamera 的缩写（与安装包文件名一致）
                    · 纯 ASCII 路径可避开 MSI 8.3 短文件名把中文折叠成 '????' 的问题
                      （此前 ICE30 报错里实际出现过 [ProgramFiles64Folder]\i8gueiie\????\）
                    · 用户可见的显示名仍然是中文「视频展台」（快捷方式 / 控制面板）
                -->
                <Directory Id="INSTALLFOLDER" Name="vdc"/>
            </Directory>
        </StandardDirectory>

        <StandardDirectory Id="ProgramMenuFolder">
            <Directory Id="AppMenuFolder" Name="UNSA Studio"/>
        </StandardDirectory>

        <StandardDirectory Id="DesktopFolder"/>

        <!-- ══════════ 功能与组件 ══════════ -->
        <Feature Id="MainFeature" Title="视频展台" Level="1" AllowAbsent="no">
            <ComponentGroupRef Id="AppFilesGroup"/>
            <ComponentGroupRef Id="ShortcutGroup"/>
        </Feature>

    </Package>

    <!--
        ══════════════════ 主程序文件 ══════════════════

        ComponentGroup Id="AppFilesGroup" 不在这里定义 —— 它由 build.ps1
        扫描 dist/app 后生成的 GeneratedFiles.wxs 提供。

        原因：WiX v4.0.4 的 <ComponentGroup> 不接受 <Files> 收割元素，
              会报 "The ComponentGroup element contains an unexpected child
              element 'Files'"，因此改为「构建时生成标准 fragment」，
              等价于 heat.exe，但不依赖 WiX 的具体版本行为。
    -->

    <!-- ══════════════════ 快捷方式 / 卸载信息 ══════════════════ -->
    <Fragment>
        <ComponentGroup Id="ShortcutGroup" Directory="INSTALLFOLDER">

            <Component Id="ShortcutsComponent" Guid="{8B4C2E16-7F93-4D0A-B5E2-91A6C0D4F738}">
                <!-- 桌面快捷方式：指向启动器 -->
                <Shortcut Id="DesktopShortcut"
                          Directory="DesktopFolder"
                          Name="视频展台"
                          Description="视频展台 —— UNSA Studio"
                          Target="[INSTALLFOLDER]VideoPresenter.Launcher.exe"
                          WorkingDirectory="INSTALLFOLDER"
                          Icon="VpAppIcon"/>

                <!-- 开始菜单快捷方式 -->
                <Shortcut Id="StartMenuShortcut"
                          Directory="AppMenuFolder"
                          Name="视频展台"
                          Description="视频展台 —— UNSA Studio"
                          Target="[INSTALLFOLDER]VideoPresenter.Launcher.exe"
                          WorkingDirectory="INSTALLFOLDER"
                          Icon="VpAppIcon"/>

                <RemoveFolder Id="RemoveAppMenuFolder" Directory="AppMenuFolder" On="uninstall"/>

                <!-- 组件 KeyPath（同时用于标记"已安装"状态） -->
                <RegistryValue Root="HKCU"
                               Key="Software\UNSA Studio\视频展台"
                               Name="InstalledVersion"
                               Type="string"
                               Value="$(VpVersion)"
                               KeyPath="yes"/>
            </Component>

        </ComponentGroup>
    </Fragment>

</Wix>